{
  "name": "futsal-scout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Scout automatico de futbol sala: corta el partido en fragmentos de juego, se corrige a mano y se comparte con los jugadores.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tipos:worker": "wrangler types src/servidor/worker-configuration.d.ts",
    "typecheck": "npm run tipos:worker && tsc -p tsconfig.nucleo.json && tsc -p tsconfig.cliente.json && tsc -p tsconfig.servidor.json && tsc -p tsconfig.json",
    "deploy": "npm run build && wrangler deploy",
    "videos:prueba": "bash tools/crear_videos_prueba.sh"
  },
  "dependencies": {
    "mediabunny": "^1.65.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
